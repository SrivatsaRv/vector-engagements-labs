# Local PostGIS development connection. Override outside source control.
DATABASE_URL=postgres://vector:vector@127.0.0.1:55433/vector

# Direct production origin used only by protected migration and provisioning
# jobs. The deployed Worker reaches PostgreSQL through Hyperdrive instead.
PROD_DATABASE_ORIGIN_URL=

# Cloudflare deployment values are intentionally blank in the public example.
# Store real values in GitHub's protected production environment or an ignored
# local secret store. Never commit an API token.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_HYPERDRIVE_ID=
VECTOR_PRODUCTION_HOST=

# Local-only observability credentials. Production metrics must use a Worker
# secret and are not exposed without a valid bearer token.
VECTOR_GRAFANA_PASSWORD=replace-with-a-local-password
