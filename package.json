{
  "name": "vector-engagement-lab",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SrivatsaRv/vector-engagements-labs.git"
  },
  "bugs": {
    "url": "https://github.com/SrivatsaRv/vector-engagements-labs/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "npm run map:assets:prepare",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "prebuild": "npm run map:assets:prepare",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "deploy": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext deploy",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs && tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0 --ignore-pattern dist --ignore-pattern .next --ignore-pattern engine-rust/target --ignore-pattern public/vendor",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate-db.mjs",
    "db:seed": "tsx scripts/seed-db.ts",
    "db:verify": "node scripts/verify-db.mjs",
    "app:verify": "node scripts/verify-app.mjs",
    "observability:verify": "node scripts/verify-observability.mjs",
    "performance:verify": "tsx scripts/benchmark-engine.ts",
    "models:generate": "tsx scripts/generate-model-pack-fixture.ts",
    "models:verify": "tsx scripts/generate-model-pack-fixture.ts --check",
    "worker:verify": "tsx scripts/verify-browser-worker.ts",
    "runtime:verify": "node --import tsx --test tests/browser-runtime.test.mjs tests/vector-record.test.mjs tests/engine-backends.test.mjs",
    "symbols:generate": "node scripts/generate-tactical-icons.mjs",
    "symbols:verify": "node scripts/generate-tactical-icons.mjs --check",
    "map:assets:prepare": "node scripts/prepare-maplibre-assets.mjs",
    "engine:rust:build": "node scripts/build-rust-engine.mjs",
    "engine:rust:verify": "node scripts/build-rust-engine.mjs --check",
    "engine:rust:fmt": "cargo fmt --manifest-path engine-rust/Cargo.toml -- --check",
    "engine:rust:clippy": "cargo clippy --manifest-path engine-rust/Cargo.toml --locked --all-targets --all-features -- -D warnings",
    "engine:rust:test": "cargo test --manifest-path engine-rust/Cargo.toml --locked --all-targets --all-features",
    "engine:rust:doc": "RUSTDOCFLAGS='-D warnings' cargo doc --manifest-path engine-rust/Cargo.toml --locked --no-deps",
    "ui:responsive:verify": "node scripts/verify-responsive-ui.mjs"
  },
  "dependencies": {
    "@types/three": "^0.185.3",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.28.0",
    "maplibre-gl": "^6.1.0",
    "next": "^16.2.12",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@cloudflare/workers-types": "5.20260804.1",
    "@iconify-json/game-icons": "^1.2.4",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.32",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "mermaid": "^11.16.1",
    "playwright-core": "1.62.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.5",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.0",
    "wrangler": "4.118.0"
  },
  "type": "module"
}
