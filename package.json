{
  "name": "vector-engagement-lab",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SrivatsaRv/vector-engagements-labs.git"
  },
  "bugs": {
    "url": "https://github.com/SrivatsaRv/vector-engagements-labs/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "npm run map:assets:prepare",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "prebuild": "npm run map:assets:prepare",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build && node scripts/build-runtime-bundles.mjs && node scripts/verify-tp1538-source-manifest.mjs --production-only",
    "deploy": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext deploy",
    "start": "node dist/runtime/start-production.mjs",
    "test": "npm run build && node --test tests/*.test.mjs && tsx --test tests/*.test.ts",
    "test:component": "vitest run",
    "test:browser": "playwright test",
    "test:browser:ci": "npm run build && node scripts/run-browser-contracts.mjs",
    "test:admission:integration": "tsx --test tests/runtime-admission-db.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0 --ignore-pattern dist --ignore-pattern .next --ignore-pattern engine-rust/target --ignore-pattern verification-rust/generic-aam/target --ignore-pattern verification-rust/tp1538-aero/target --ignore-pattern public/vendor --ignore-pattern blog",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate-db.mjs",
    "db:governed-data:verify": "tsx scripts/verify-governed-catalog-data.ts",
    "db:credibility:verify": "node scripts/verify-credibility-catalog.mjs",
    "db:seed": "tsx scripts/seed-db.ts",
    "db:verify": "node scripts/verify-db.mjs",
    "db:environment-upgrade:verify": "node scripts/verify-db.mjs --environment-upgrade-only",
    "db:aircraft-upgrade:verify": "node scripts/verify-aircraft-evidence-db-upgrade.mjs",
    "app:verify": "node scripts/verify-app.mjs",
    "observability:verify": "node scripts/verify-observability.mjs",
    "performance:verify": "tsx scripts/benchmark-engine.ts",
    "performance:generic-takeoff:verify": "tsx scripts/benchmark-generic-takeoff.ts",
    "performance:generic-airborne-store-transfer:verify": "tsx scripts/benchmark-generic-airborne-store-transfer.ts",
    "performance:model-pack-foundation:verify": "tsx scripts/benchmark-model-pack-foundation.ts",
    "performance:environment:verify": "tsx scripts/benchmark-environment.ts",
    "performance:track-store:verify": "node --import tsx scripts/benchmark-track-store.ts",
    "capacity:baseline:verify": "tsx scripts/benchmark-capacity-baseline.ts",
    "models:generate": "tsx scripts/generate-model-pack-fixture.ts",
    "models:verify": "tsx scripts/generate-model-pack-fixture.ts --check",
    "models:aircraft-foundation:generate": "tsx scripts/generate-aircraft-model-pack-foundation-fixtures.ts",
    "models:aircraft-foundation:verify": "tsx scripts/generate-aircraft-model-pack-foundation-fixtures.ts --check",
    "reference-aircraft:verify": "node --import tsx scripts/verify-public-aircraft-reference.mjs",
    "reference-aam:verify": "node --import tsx scripts/verify-nasa-generic-aam-reference.mjs",
    "reference-aam:performance": "tsx scripts/benchmark-generic-aam.ts --profile=APPLE_M5_NODE24",
    "worker:verify": "tsx scripts/verify-browser-worker.ts",
    "runtime:verify": "node --import tsx --test tests/browser-runtime.test.mjs tests/vector-record.test.mjs tests/engine-backends.test.mjs",
    "symbols:generate": "node scripts/generate-tactical-icons.mjs",
    "symbols:verify": "node scripts/generate-tactical-icons.mjs --check",
    "policy:runtime-stubs:verify": "node scripts/verify-runtime-stub-ledger.mjs",
    "policy:aircraft-evidence:verify": "node scripts/verify-aircraft-evidence-registry.mjs",
    "policy:nasa-generic-f16:verify": "node scripts/verify-nasa-generic-f16-reference.mjs",
    "policy:nasa-f16-store-source:verify": "node --require ./scripts/lib/generic-sensor-network-deny.cjs scripts/generate-nasa-f16-store-source-evidence.mjs && node --require ./scripts/lib/generic-sensor-network-deny.cjs scripts/verify-nasa-f16-store-source.mjs --source-dir governance/nasa-historical-f16-store-source/sources && node --require ./scripts/lib/generic-sensor-network-deny.cjs --test tests/nasa-f16-store-source.test.mjs",
    "policy:generic-mission-policy-source:verify": "node --require ./scripts/lib/generic-sensor-network-deny.cjs scripts/verify-generic-mission-policy-governance.mjs && node --require ./scripts/lib/generic-sensor-network-deny.cjs --test tests/generic-mission-policy-source.test.mjs",
    "generic-mission-policy:sources:verify": "node --require ./scripts/lib/generic-sensor-network-deny.cjs scripts/verify-generic-mission-policy-source.mjs",
    "policy:contract-docs:verify": "node scripts/verify-contract-doc-impact.mjs",
    "policy:contract-docs:template": "node scripts/verify-contract-doc-impact.mjs --print-template",
    "environment:sources:verify": "node scripts/verify-environment-source-assets.mjs",
    "generic-sensor:sources:verify": "node --require ./scripts/lib/generic-sensor-network-deny.cjs scripts/generate-generic-sensor-source-manifest.mjs && node --require ./scripts/lib/generic-sensor-network-deny.cjs scripts/verify-generic-sensor-source-bundle.mjs && node --require ./scripts/lib/generic-sensor-network-deny.cjs --test tests/generic-sensor-source-bundle.test.mjs",
    "environment:migration:generate": "tsx scripts/generate-environment-scenario-migration.ts --write",
    "environment:migration:verify": "tsx scripts/generate-environment-scenario-migration.ts --check",
    "ground-dynamics:migration:generate": "tsx scripts/generate-ground-dynamics-scenario-migration.ts --write",
    "ground-dynamics:migration:verify": "tsx scripts/generate-ground-dynamics-scenario-migration.ts --check",
    "tp1538:sources:generate": "node scripts/generate-tp1538-source-manifest.mjs",
    "tp1538:sources:verify": "node scripts/verify-tp1538-source-manifest.mjs",
    "tp1538:aero:adjudication:verify": "node --test tests/tp1538-adjudication-cli.test.mjs",
    "tp1538:aero:workload:generate": "node scripts/generate-tp1538-aero-workload.mjs",
    "tp1538:aero:workload:verify": "node scripts/generate-tp1538-aero-workload.mjs --check",
    "tp1538:aero:reference:verify": "node --test tests/tp1538-aero-reference.test.mjs",
    "tp1538:aero:benchmark": "node scripts/benchmark-tp1538-aero.mjs",
    "tp1538:aero:schema:generate": "node scripts/generate-tp1538-rust-schema.mjs",
    "tp1538:aero:schema:verify": "node scripts/generate-tp1538-rust-schema.mjs --check",
    "tp1538:aero:rust:build": "node scripts/build-tp1538-aero-verifier.mjs",
    "tp1538:aero:rust:verify": "node scripts/build-tp1538-aero-verifier.mjs --check",
    "tp1538:aero:rust:fmt": "cargo fmt --manifest-path verification-rust/tp1538-aero/Cargo.toml -- --check",
    "tp1538:aero:rust:clippy": "cargo clippy --manifest-path verification-rust/tp1538-aero/Cargo.toml --locked --all-targets -- -D warnings",
    "tp1538:aero:rust:test": "cargo test --manifest-path verification-rust/tp1538-aero/Cargo.toml --locked --all-targets",
    "tp1538:aero:rust:doc": "RUSTDOCFLAGS='-D warnings' cargo doc --manifest-path verification-rust/tp1538-aero/Cargo.toml --locked --no-deps",
    "map:assets:prepare": "node scripts/prepare-maplibre-assets.mjs",
    "engine:rust:build": "node scripts/build-rust-engine.mjs",
    "engine:rust:verify": "node scripts/build-rust-engine.mjs --check",
    "reference-aam:rust:build": "node scripts/build-generic-aam-verifier.mjs",
    "reference-aam:rust:verify": "node scripts/build-generic-aam-verifier.mjs --check",
    "reference-aam:rust:fmt": "cargo fmt --manifest-path verification-rust/generic-aam/Cargo.toml -- --check",
    "reference-aam:rust:clippy": "cargo clippy --manifest-path verification-rust/generic-aam/Cargo.toml --locked --all-targets -- -D warnings",
    "reference-aam:rust:test": "cargo test --manifest-path verification-rust/generic-aam/Cargo.toml --locked --all-targets",
    "reference-aam:rust:doc": "RUSTDOCFLAGS='-D warnings' cargo doc --manifest-path verification-rust/generic-aam/Cargo.toml --locked --no-deps",
    "engine:rust:fmt": "cargo fmt --manifest-path engine-rust/Cargo.toml -- --check",
    "engine:rust:clippy": "cargo clippy --manifest-path engine-rust/Cargo.toml --locked --all-targets --all-features -- -D warnings",
    "engine:rust:test": "cargo test --manifest-path engine-rust/Cargo.toml --locked --all-targets --all-features",
    "engine:rust:doc": "RUSTDOCFLAGS='-D warnings' cargo doc --manifest-path engine-rust/Cargo.toml --locked --no-deps",
    "ui:responsive:verify": "node scripts/verify-responsive-ui.mjs",
    "blog:visual:verify": "node scripts/verify-blog-editorial.mjs",
    "container:verify": "node scripts/verify-container-image.mjs"
  },
  "dependencies": {
    "@types/three": "^0.185.4",
    "drizzle-orm": "0.45.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.31.0",
    "maplibre-gl": "^6.4.0",
    "next": "^16.3.1",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.0",
    "undici": "7.29.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.46.0",
    "@cloudflare/workers-types": "5.20260721.1",
    "@iconify-json/game-icons": "^1.2.4",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "binaryen": "131.0.0",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "jsdom": "^29.1.1",
    "marked": "16.4.2",
    "mermaid": "^11.16.1",
    "playwright-core": "1.62.1",
    "react-server-dom-webpack": "19.2.8",
    "sharp": "0.35.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vinext": "0.2.1",
    "vite": "8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "4.113.0"
  },
  "type": "module"
}
