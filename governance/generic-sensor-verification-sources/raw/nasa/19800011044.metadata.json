{"copyright":{"thirdPartyPermissionsProduced":false,"disclosedToPublic":false,"containsIndication":false,"publisherPermissionOrRightsToDistribute":false,"belongsToUsGov":false,"determinationType":"GOV_PUBLIC_USE_PERMITTED","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"disclosedInvention":false,"submissionId":19800011044,"containsThirdPartyMaterial":false,"belongsToPublisher":false,"id":"1938af79966845c8ad8f499e80b00b87","belongsToAuthors":false},"subjectCategories":["Communications And Radar"],"exportControl":{"isExportControl":"NO","submissionId":19800011044,"ear":"NO","id":"8a493e393b914c1799982375800fcf13","itar":"NO"},"distributionDate":"2019-06-21T00:00:00.0000000+00:00","otherReportNumbers":["R8001-2","NASA-CR-160557","Report Number: R8001-2","Report Number: NASA-CR-160557"],"fundingNumbers":[{"number":"NAS9-15795","submissionId":19800011044,"id":"00aaad6fb6d849148c73838b3d66233e","type":"CONTRACT_GRANT"}],"title":"Ku-band radar threshold analysis","stiType":"CONTRACTOR_REPORT","distribution":"PUBLIC","submittedDate":"2013-09-04T16:24:00.0000000+00:00","authorAffiliations":[{"sequence":0,"submissionId":19800011044,"meta":{"author":{"name":"Weber, C. L."},"organization":{"name":"Axiomatix","location":"Los Angeles, CA, United States"}},"id":"87dc6f548c6d4209bb839b13cc57bbb6"},{"sequence":1,"submissionId":19800011044,"meta":{"author":{"name":"Polydoros, A."},"organization":{"name":"Axiomatix","location":"Los Angeles, CA, United States"}},"id":"d86989f70efe4bdd9618fd928e8d4271"}],"stiTypeDetails":"Contractor Report (CR)","technicalReviewType":"TECHNICAL_REVIEW_TYPE_NONE","modified":"2025-08-31T18:39:21.7150190+00:00","id":19800011044,"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":"80N19322"},"created":"2013-09-04T16:24:00.0000000+00:00","center":{"code":"CDMS","name":"Legacy CDMS","id":"092d6e0881874968859b972d39a888dc"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"The statistics of the CFAR threshold for the Ku-band radar was determined. Exact analytical results were developed for both the mean and standard deviations in the designated search mode. The mean value is compared to the results of a previously reported simulation. The analytical results are more optimistic than the simulation results, for which no explanation is offered. The normalized standard deviation is shown to be very sensitive to signal-to-noise ratio and very insensitive to the noise correlation present in the range gates of the designated search mode. The substantial variation in the CFAR threshold is dominant at large values of SNR where the normalized standard deviation is greater than 0.3. Whether or not this significantly affects the resulting probability of detection is a matter which deserves additional attention.","isLessonsLearned":false,"disseminated":"DOCUMENT_AND_METADATA","publications":[{"submissionId":19800011044,"id":"a0db41144e7e4839b67c300133f88e88","publicationDate":"1979-01-11T00:00:00.0000000+00:00"}],"status":"CURATED","related":[],"downloads":[{"draft":false,"mimetype":"application/pdf","name":"19800011044.pdf","type":"STI","links":{"original":"/api/citations/19800011044/downloads/19800011044.pdf","pdf":"/api/citations/19800011044/downloads/19800011044.pdf","fulltext":"/api/citations/19800011044/downloads/19800011044.txt"}}],"downloadsAvailable":true,"index":"submissions-2026-08-20-04-13"}