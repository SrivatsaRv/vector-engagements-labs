{"copyright":{"thirdPartyPermissionsProduced":false,"disclosedToPublic":false,"containsIndication":false,"publisherPermissionOrRightsToDistribute":false,"belongsToUsGov":false,"determinationType":"GOV_PUBLIC_USE_PERMITTED","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"disclosedInvention":false,"submissionId":19800005879,"containsThirdPartyMaterial":false,"belongsToPublisher":false,"id":"368759888cf34798bc0ce220d1ef41ce","belongsToAuthors":false},"subjectCategories":["Aircraft Stability And Control"],"exportControl":{"isExportControl":"NO","submissionId":19800005879,"ear":"NO","id":"2bb5325b214b4a5e85493ae0f6eed770","itar":"NO"},"distributionDate":"2019-06-21T00:00:00.0000000+00:00","otherReportNumbers":["NASA-TP-1538","L-12854","Report Number: NASA-TP-1538","Report Number: L-12854"],"fundingNumbers":[{"number":"RTOP 505-06-63-03","submissionId":19800005879,"id":"434f2112ea8041438a9e80fcbbfeba8d","type":"PROJECT"}],"title":"Simulator study of stall/post-stall characteristics of a fighter airplane with relaxed longitudinal static stability","stiType":"TECHNICAL_PUBLICATION","distribution":"PUBLIC","submittedDate":"2013-09-04T16:52:00.0000000+00:00","authorAffiliations":[{"sequence":0,"submissionId":19800005879,"meta":{"author":{"name":"Nguyen, L. T."},"organization":{"name":"NASA Langley Research Center","location":"Hampton, VA, United States"}},"id":"0d3773e8760648b49f6100e93801fff3"},{"sequence":1,"submissionId":19800005879,"meta":{"author":{"name":"Ogburn, M. E."},"organization":{"name":"NASA Langley Research Center","location":"Hampton, VA, United States"}},"id":"b3bfafae1abe4b90891a687d56e49b3d"},{"sequence":2,"submissionId":19800005879,"meta":{"author":{"name":"Gilbert, W. P."},"organization":{"name":"NASA Langley Research Center","location":"Hampton, VA, United States"}},"id":"d470e5387bde4988ab1bbebde1b3b633"},{"sequence":3,"submissionId":19800005879,"meta":{"author":{"name":"Kibler, K. S."},"organization":{"name":"NASA Langley Research Center","location":"Hampton, VA, United States"}},"id":"08cc4bfe61b54beca7be050b1be95221"},{"sequence":4,"submissionId":19800005879,"meta":{"author":{"name":"Brown, P. W."},"organization":{"name":"NASA Langley Research Center","location":"Hampton, VA, United States"}},"id":"bee4be0b30e44606892201497d427e7f"},{"sequence":5,"submissionId":19800005879,"meta":{"author":{"name":"Deal, P. L."},"organization":{"name":"NASA Langley Research Center","location":"Hampton, VA, United States"}},"id":"35d08d4323ec4bbfa317fe9380bdbd90"}],"stiTypeDetails":"Technical Publication (TP)","technicalReviewType":"TECHNICAL_REVIEW_TYPE_NONE","modified":"2025-08-31T18:39:21.7150190+00:00","id":19800005879,"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":"80N14136"},"created":"2013-09-04T16:52:00.0000000+00:00","center":{"code":"CDMS","name":"Legacy CDMS","id":"092d6e0881874968859b972d39a888dc"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"A real-time piloted simulation was conducted to evaluate the high-angle-of-attack characteristics of a fighter configuration based on wind-tunnel testing of the F-16, with particular emphasis on the effects of various levels of relaxed longitudinal static stability. The aerodynamic data used in the simulation was conducted on the Langley differential maneuvering simulator, and the evaluation involved representative low-speed combat maneuvering. Results of the investigation show that the airplane with the basic control system was resistant to the classical yaw departure; however, it was susceptible to pitch departures induced by inertia coupling during rapid, large-amplitude rolls at low airspeed. The airplane also exhibited a deep-stall trim which could be flown into and from which it was difficult to recover. Control-system modifications were developed which greatly decreased the airplane susceptibility to the inertia-coupling departure and which provided a reliable means for recovering from the deep stall.","isLessonsLearned":false,"disseminated":"DOCUMENT_AND_METADATA","publications":[{"submissionId":19800005879,"id":"1cd17ae63aef4e479a9c08ed7b12e690","publicationDate":"1979-12-01T00:00:00.0000000+00:00"}],"status":"CURATED","related":[],"downloads":[{"draft":false,"mimetype":"application/pdf","name":"19800005879.pdf","type":"STI","links":{"original":"/api/citations/19800005879/downloads/19800005879.pdf","pdf":"/api/citations/19800005879/downloads/19800005879.pdf","fulltext":"/api/citations/19800005879/downloads/19800005879.txt"}}],"downloadsAvailable":true,"index":"submissions-2026-08-20-04-13"}